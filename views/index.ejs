        <div class="blog">

            <h2>Blog</h2>

            <p>Lisez les derniers post en date</p>


        </div>

        <div class="blog1">
            <div class="text">
                <h3>Thaïlande, Krabi</h3>
                <p id="histoire">La ville de Krabi en Thaïlande est l'une des meilleures villes que j'ai pu faire dans ce pays. Entre les paysages paradisiaques, les balades en scooters et les activités nautiques, cette destination à tous pour vous faire kiffer !</p>
                <p id="name">Par Ascareel</p>
            </div>
            <img src="/img/in-Krabi.jpg" alt="krabi" width="30%" class="img1">            
        </div>

        <div class="blog2">
            <img src="img/barcelona-beach-beautiful-sunset-955x508.jpg" alt="krabi" width="30%" class="img1">            
            <div class="text">
                <h3>Espagne, Barcelone</h3>
                <p id="histoire">La ville de Barcelone en Espagne est une ville chill où on peut se détendre, entre balade en scooter, activités nautiques, et balades à pieds dans la ville, cette ville est certainement l'une des meilleures à faire dans le pays.</p>
                <p id="name">Par Ascareel</p>
            </div>
        </div>

    </div>

    <% if(locals.Prénom || locals.Pays || locals.Ville || locals.Image || locals.Histoire) { %>

        <div class="blog1">
            <div class="text">
                <h3><%= Pays %>, <%=  Ville %></h3>
                <p id="histoire"><%= Histoire %></p>
                <p id="name">By <%= Prénom %></p>
            </div>
            <img src="<%= Image  %>" alt="krabi" width="30%" class="img1">            
        </div>
        
    <% } %>    
    

    

    <footer>
        <div class="logo"> 
            <p>LOGO <span>Y</span></p>
        </div>

        <p id="copyright">© 2025 LogoY. All rights reserved.</p>
    </footer>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
    <script src="script/script.js"></script>

</body>
</html>